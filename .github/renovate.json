{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "description": "Major updates wait for approval on the Dependency Dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The 1.x parity tests compare against chartist 1.5.0.",
      "matchDepNames": ["chartist-v1"],
      "enabled": false
    }
  ]
}
