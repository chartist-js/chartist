{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "paths": {
      "chartist": ["../../dist/index.d.ts"],
      "chartist/compat": ["../../dist/compat.d.ts"],
      "chartist/live": ["../../dist/live.d.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"]
}
