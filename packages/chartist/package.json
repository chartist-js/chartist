{
  "name": "chartist",
  "type": "module",
  "version": "1.5.0",
  "description": "Simple, responsive charts",
  "author": "Gion Kunz",
  "homepage": "https://chartist.dev",
  "license": "MIT OR WTFPL",
  "licenses": [
    {
      "type": "WTFPL",
      "url": "https://github.com/chartist-js/chartist/blob/main/LICENSE-WTFPL"
    },
    {
      "type": "MIT",
      "url": "https://github.com/chartist-js/chartist/blob/main/LICENSE-MIT"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chartist-js/chartist.git"
  },
  "bugs": {
    "url": "https://github.com/chartist-js/chartist/issues"
  },
  "keywords": [
    "chartist",
    "responsive charts",
    "charts",
    "charting"
  ],
  "engines": {
    "node": ">=14"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "sass": "./dist/scss/index.scss",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "sass": "./dist/scss/index.scss",
      "style": "./dist/index.css",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./scss/*": "./dist/scss/*",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "directory": "package",
    "linkDirectory": false
  },
  "files": [
    "dist",
    "LICENSE-WTFPL",
    "LICENSE-MIT"
  ],
  "scripts": {
    "clear:package": "del ./package",
    "clear": "del ./package ./dist ./coverage",
    "prepublishOnly": "pnpm test && pnpm build && pnpm clear:package && clean-publish",
    "postpublish": "pnpm clear:package",
    "build:styles": "node ./scripts/styles.cjs",
    "build": "del-cli ./dist && tsdown && node ./scripts/styles.cjs",
    "jest": "jest -c jest.config.json",
    "test:size": "size-limit",
    "test:unit": "jest -c jest.config.json ./src",
    "test": "pnpm lint && pnpm test:unit",
    "lint": "eslint './*.{js,ts,cjs}' 'test/**/*.{js,ts}' 'src/**/*.{js,ts}' 'scripts/**/*.{js,ts,cjs}'",
    "format": "echo \"Format from the workspace root: pnpm nx format\"",
    "test:smoke": "node --test \"test/smoke/*.test.mjs\"",
    "test:visual": "playwright test -c test/visual/playwright.config.ts",
    "test:visual:v1": "CHARTIST_LIB=v1 playwright test -c test/visual/playwright.config.ts",
    "test:visual:update": "CHARTIST_LIB=v1 playwright test -c test/visual/playwright.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@chartist/examples": "workspace:*",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@playwright/test": "1.63.0",
    "@size-limit/esbuild": "14.1.0",
    "@size-limit/file": "14.1.0",
    "@swc/core": "^1.2.165",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.20",
    "@testing-library/jest-dom": "^5.16.4",
    "@types/jest": "^27.5.1",
    "@types/node": "^18.0.0",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "^5.25.0",
    "@typescript-eslint/parser": "^5.25.0",
    "browserslist": "^4.20.2",
    "chartist-v1": "npm:chartist@1.5.0",
    "clean-publish": "^4.0.1",
    "cssnano": "^4.1.11",
    "del-cli": "^5.0.0",
    "eslint": "^8.15.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jest": "^27.0.0",
    "eslint-plugin-jest-dom": "^4.0.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-testing-library": "^5.5.0",
    "jest": "^27.5.1",
    "playwright": "1.63.0",
    "postcss": "^8.0.0",
    "postcss-preset-env": "^6.7.1",
    "prettier": "^2.6.2",
    "sass": "^1.50.1",
    "size-limit": "14.1.0",
    "tsdown": "0.23.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "nx": {
    "implicitDependencies": [
      "!examples"
    ],
    "namedInputs": {
      "build": [
        "{projectRoot}/src/**/*",
        "!{projectRoot}/src/**/*.spec.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/tsdown.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.build.json",
        "{projectRoot}/scripts/styles.cjs",
        "{projectRoot}/.browserslistrc",
        {
          "externalDependencies": [
            "tsdown",
            "typescript",
            "sass",
            "postcss",
            "postcss-preset-env",
            "cssnano"
          ]
        }
      ]
    },
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test:size": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/.size-limit.json",
          {
            "externalDependencies": [
              "size-limit",
              "@size-limit/file",
              "@size-limit/esbuild"
            ]
          }
        ]
      },
      "test:smoke": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/test/smoke/**/*",
          "{projectRoot}/examples/**/*",
          {
            "externalDependencies": [
              "playwright",
              "sass",
              "typescript"
            ]
          }
        ]
      },
      "test:visual": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/test/visual/**/*",
          "!{projectRoot}/test/visual/test-results/**/*",
          "!{projectRoot}/test/visual/playwright-report/**/*",
          "{workspaceRoot}/packages/examples/**/*",
          "!{workspaceRoot}/packages/examples/node_modules/**/*",
          {
            "externalDependencies": [
              "@playwright/test",
              "vite"
            ]
          }
        ]
      },
      "test:visual:v1": {
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/test/visual/**/*",
          "!{projectRoot}/test/visual/test-results/**/*",
          "!{projectRoot}/test/visual/playwright-report/**/*",
          "{workspaceRoot}/packages/examples/**/*",
          "!{workspaceRoot}/packages/examples/node_modules/**/*",
          {
            "externalDependencies": [
              "@playwright/test",
              "vite"
            ]
          }
        ]
      },
      "test:visual:update": {
        "cache": false
      }
    }
  }
}
