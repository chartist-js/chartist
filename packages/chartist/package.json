{
  "name": "chartist",
  "type": "module",
  "version": "2.0.0-rc.3",
  "description": "Simple, responsive charts",
  "author": "Gion Kunz",
  "homepage": "https://chartist.dev",
  "license": "MIT OR WTFPL",
  "licenses": [
    {
      "type": "WTFPL",
      "url": "https://github.com/chartist-js/chartist/blob/main/LICENSE-WTFPL"
    },
    {
      "type": "MIT",
      "url": "https://github.com/chartist-js/chartist/blob/main/LICENSE-MIT"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chartist-js/chartist.git",
    "directory": "packages/chartist"
  },
  "bugs": {
    "url": "https://github.com/chartist-js/chartist/issues"
  },
  "keywords": [
    "chartist",
    "responsive charts",
    "charts",
    "charting"
  ],
  "engines": {
    "node": ">=14"
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "./dist/compat.*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "sass": "./dist/scss/index.scss",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "sass": "./dist/scss/index.scss",
      "style": "./dist/index.css",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      },
      "default": "./dist/compat.js"
    },
    "./styles.css": "./dist/index.css",
    "./themes/*": "./dist/themes/*",
    "./scss/*": "./dist/scss/*",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-WTFPL",
    "LICENSE-MIT"
  ],
  "scripts": {
    "clear": "del ./dist ./coverage",
    "build:styles": "node ./scripts/styles.cjs",
    "build": "del-cli ./dist && tsdown && node ./scripts/styles.cjs",
    "test:size": "size-limit",
    "format": "echo \"Format from the workspace root: pnpm nx format\"",
    "test:smoke": "node --test \"test/smoke/*.test.mjs\"",
    "test:visual": "playwright test -c test/visual/playwright.config.ts",
    "test:visual:v1": "CHARTIST_LIB=v1 playwright test -c test/visual/playwright.config.ts",
    "test:visual:update": "CHARTIST_LIB=v1 playwright test -c test/visual/playwright.config.ts --update-snapshots",
    "test:api": "CHARTIST_API_TARGET=local vitest run --config test/api/vitest.config.ts",
    "test:api:v1": "CHARTIST_API_TARGET=v1 vitest run --config test/api/vitest.config.ts",
    "test:api:update-exports": "node test/api/exports/update.ts",
    "test:visual:local-baseline": "rm -rf test/visual/.local-baseline && CHARTIST_LIB=v1 VISUAL_SNAPSHOTS=test/visual/.local-baseline playwright test -c test/visual/playwright.config.ts --update-snapshots=all && (VISUAL_SNAPSHOTS=test/visual/.local-baseline playwright test -c test/visual/playwright.config.ts --update-snapshots=missing || true)",
    "test:visual:local": "VISUAL_SNAPSHOTS=test/visual/.local-baseline playwright test -c test/visual/playwright.config.ts"
  },
  "devDependencies": {
    "@chartist/examples": "workspace:*",
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@playwright/test": "1.63.0",
    "@size-limit/esbuild": "14.1.0",
    "@size-limit/file": "14.1.0",
    "@types/node": "^18.0.0",
    "browserslist": "^4.20.2",
    "chartist-v1": "npm:chartist@1.5.0",
    "cssnano": "^4.1.11",
    "del-cli": "^5.0.0",
    "playwright": "1.63.0",
    "postcss": "^8.0.0",
    "postcss-preset-env": "^6.7.1",
    "sass": "^1.50.1",
    "size-limit": "14.1.0",
    "tsdown": "0.23.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "nx": {
    "implicitDependencies": [
      "!examples"
    ],
    "namedInputs": {
      "build": [
        "{projectRoot}/src/**/*",
        "!{projectRoot}/src/**/*.spec.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/tsdown.config.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.build.json",
        "{projectRoot}/scripts/styles.cjs",
        "{projectRoot}/.browserslistrc",
        {
          "externalDependencies": [
            "tsdown",
            "typescript",
            "sass",
            "postcss",
            "postcss-preset-env",
            "cssnano"
          ]
        }
      ]
    },
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test:size": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/.size-limit.json",
          {
            "externalDependencies": [
              "size-limit",
              "@size-limit/file",
              "@size-limit/esbuild"
            ]
          }
        ]
      },
      "test:smoke": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/test/smoke/**/*",
          "{projectRoot}/examples/**/*",
          {
            "externalDependencies": [
              "playwright",
              "sass",
              "typescript"
            ]
          }
        ]
      },
      "test:visual": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/test/visual/**/*",
          "!{projectRoot}/test/visual/test-results/**/*",
          "!{projectRoot}/test/visual/playwright-report/**/*",
          "{workspaceRoot}/packages/examples/**/*",
          "!{workspaceRoot}/packages/examples/node_modules/**/*",
          {
            "externalDependencies": [
              "@playwright/test",
              "vite"
            ]
          }
        ]
      },
      "test:visual:v1": {
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/test/visual/**/*",
          "!{projectRoot}/test/visual/test-results/**/*",
          "!{projectRoot}/test/visual/playwright-report/**/*",
          "{workspaceRoot}/packages/examples/**/*",
          "!{workspaceRoot}/packages/examples/node_modules/**/*",
          {
            "externalDependencies": [
              "@playwright/test",
              "vite"
            ]
          }
        ]
      },
      "test:visual:update": {
        "cache": false
      },
      "test:api": {
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "build",
          "{projectRoot}/test/api/**/*",
          {
            "externalDependencies": [
              "vitest",
              "jsdom",
              "typescript"
            ]
          }
        ]
      },
      "test:api:v1": {
        "cache": true,
        "inputs": [
          "{projectRoot}/package.json",
          "{projectRoot}/test/api/**/*",
          {
            "externalDependencies": [
              "vitest",
              "jsdom",
              "typescript"
            ]
          }
        ]
      },
      "test:api:update-exports": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "test:visual:local-baseline": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "test:visual:local": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
