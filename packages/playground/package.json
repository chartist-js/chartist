{
  "name": "@chartist/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser playground for Chartist example projects",
  "license": "MIT OR WTFPL",
  "exports": {
    ".": "./src/index.ts",
    "./compile": "./src/compile.ts",
    "./preview": "./src/run.ts",
    "./share": "./src/share.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --base /chartist/",
    "preview": "node test/e2e/serve.mjs",
    "test:e2e": "playwright test",
    "measure": "node scripts/measure.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "1.5.6",
    "@lezer/lr": "1.4.11",
    "@playwright/test": "1.64.1",
    "@stackblitz/sdk": "1.11.1",
    "@chartist-js/terminal": "workspace:*",
    "chartist": "workspace:*",
    "es-module-lexer": "3.0.4",
    "sucrase": "3.35.1",
    "ts-blank-space": "0.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "nx": {
    "name": "playground",
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "preview": {
        "dependsOn": [
          "build"
        ],
        "continuous": true
      },
      "test:e2e": {
        "dependsOn": [
          "build"
        ]
      },
      "measure": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
