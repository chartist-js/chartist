{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "dev": {
      "executor": "@geekvetica/nx-astro:dev",
      "options": {},
      "cache": false,
      "dependsOn": ["api"]
    },
    "build": {
      "executor": "@geekvetica/nx-astro:build",
      "options": {},
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/package.json",
        {
          "externalDependencies": ["astro"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "cache": true,
      "dependsOn": ["^build", "api"]
    },
    "preview": {
      "executor": "@geekvetica/nx-astro:preview",
      "options": {},
      "cache": false,
      "dependsOn": ["build"]
    },
    "check": {
      "executor": "@geekvetica/nx-astro:check",
      "options": {},
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["astro", "typescript"]
        }
      ],
      "cache": true,
      "dependsOn": ["sync", "samples", "api", "test"]
    },
    "sync": {
      "executor": "@geekvetica/nx-astro:sync",
      "options": {},
      "inputs": [
        "{projectRoot}/src/content/**/*",
        {
          "externalDependencies": ["astro"]
        }
      ],
      "outputs": [],
      "cache": true,
      "metadata": {
        "technologies": ["astro"],
        "description": "Generate TypeScript types for Astro Content Collections and modules (via astro sync)"
      }
    },
    "e2e": {
      "command": "playwright test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "facts": {
      "command": "node scripts/facts.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": false
    },
    "visual": {
      "command": "node e2e/visual.mjs",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "cache": false,
      "metadata": {
        "description": "Screenshot comparison with a baseline: --update takes it, --only filters shots, --baseline points elsewhere"
      }
    },
    "samples": {
      "command": "node scripts/check-samples.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/src/content/docs/**/*",
        "{projectRoot}/scripts/check-samples.ts",
        "^production"
      ],
      "cache": true,
      "metadata": {
        "description": "Type-checks the TypeScript code blocks of the docs pages against Chartist's types"
      }
    },
    "api": {
      "command": "typedoc --options api/typedoc.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/packages/chartist/src/**/*",
        "{projectRoot}/api/*",
        {
          "externalDependencies": ["typedoc", "typescript"]
        }
      ],
      "outputs": ["{projectRoot}/src/generated/api.json"],
      "cache": true,
      "metadata": {
        "description": "Writes the API model of chartist and chartist/compat (TypeDoc JSON) for the reference pages"
      }
    },
    "test": {
      "dependsOn": ["api"]
    }
  }
}
