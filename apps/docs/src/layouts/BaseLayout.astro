---
import '@fontsource/zilla-slab/500.css';
import '@fontsource/zilla-slab/600.css';
import '@fontsource/zilla-slab/700.css';
import '@fontsource/zilla-slab/500-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/jetbrains-mono/wght-italic.css';
import zilla700 from '@fontsource/zilla-slab/files/zilla-slab-latin-700-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CARD_HEIGHT, CARD_WIDTH, cardPath } from '../lib/og';
import { href } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Header section to mark as current. */
  section?: string;
  /** The share card's site path, e.g. `og/docs/line-charts.png`; by default the page's own (lib/og.ts). */
  image?: string;
  /** The page's Markdown version, a site path such as `docs/line-charts.md` (design D6). */
  markdown?: string;
}

const { title, description, section, image, markdown } = Astro.props;
const fullTitle = title === 'Chartist' ? title : `${title} · Chartist`;
// Share previews (design D2, polish-docs-site): absolute URLs from the site.
const site = Astro.site ?? Astro.url;
const notFound = /\/404(\.html|\/)?$/.test(Astro.url.pathname);
const canonical = notFound ? undefined : new URL(Astro.url.pathname, site).href;
const card = new URL(href(image ?? cardPath(Astro.url.pathname, import.meta.env.BASE_URL)), site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {markdown && <link rel="alternate" type="text/markdown" href={href(markdown)} title="Markdown" />}
    {notFound && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={section === 'docs' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Chartist" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={card} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(CARD_WIDTH)} />
    <meta property="og:image:height" content={String(CARD_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={zilla700} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Before the first paint: the saved theme, else light (the default).
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('chartist-theme');
        } catch {
          // No storage (private mode): use the default.
        }
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader active={section} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { addCopyButtons } from '../scripts/copy';
      addCopyButtons();
    </script>
  </body>
</html>
