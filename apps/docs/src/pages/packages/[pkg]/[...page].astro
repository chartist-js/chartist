---
import { render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { PACKAGES } from '../../../data/packages';
import { navPages, packageEntries, packagePageParam } from '../../../lib/docs';

/** Each package's overview (`/packages/<slug>/`) and guides. */
export async function getStaticPaths() {
  const paths = await Promise.all(
    PACKAGES.map(async pkg =>
      (await packageEntries(pkg.slug)).map(entry => ({
        params: { pkg: pkg.slug, page: packagePageParam(entry) },
        props: { entry }
      }))
    )
  );
  return paths.flat();
}

const { entry } = Astro.props;
const { pkg, page: name } = Astro.params;
const { Content, headings } = await render(entry);
const page = (await navPages('packages', pkg)).find(candidate => candidate.key === `${pkg}/${name ?? 'index'}`)!;
---

<DocsLayout page={page} headings={headings}>
  <Content />
</DocsLayout>
