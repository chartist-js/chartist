---
/** One page of the API reference. */
import Entry from '../../components/api/Entry.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { sortedEntries } from '../../lib/api';
import { API_PAGES } from '../../lib/api-pages';
import { navPages } from '../../lib/docs';
import { href } from '../../lib/site';

export function getStaticPaths() {
  return API_PAGES.map(page => ({ params: { slug: page.slug }, props: { legacy: page.legacy, compact: page.compact } }));
}

const { slug } = Astro.params;
const { legacy, compact } = Astro.props;
const page = (await navPages('api')).find(candidate => candidate.key === `api/${slug}`)!;
const entries = sortedEntries(slug);
const headings = entries.map(entry => ({ depth: 2, slug: entry.name, text: entry.name }));
---

<DocsLayout page={page} headings={headings}>
  {
    legacy === 'classes' && (
      <p>
        These are the 1.x classes and what only they use, kept so 1.x code runs unchanged. New code uses the chart functions: see <a href={href('api/charts/')}>Charts</a>, and{' '}
        <a href={href('docs/coming-from-1x/')}>Coming from 1.x</a> for moving over.
      </p>
    )
  }
  {
    compact && (
      <p>
        The building blocks under the charts: data normalization, scales, math and small utilities. Plugins and custom layers may use them; charts made
        with the chart functions don’t need them.
      </p>
    )
  }
  {
    slug === 'rendering' && (
      <p>
        Chartist renders a scene as SVG in the page or as a string on the server. <a href={href('packages/terminal/')}>@chartist-js/terminal</a> renders the
        same scene as text for terminals and as text art in HTML.
      </p>
    )
  }
  <div class="api-entries" data-pagefind-weight={legacy ? 0.5 : undefined}>
    {entries.map(entry => <Entry entry={entry} />)}
  </div>
</DocsLayout>
