---
/** Install snippets for npm and a native module from a CDN, as accessible tabs. */
import { Code } from 'astro:components';
import { rewriteInstallText } from '../lib/release';

const TABS = [
  {
    id: 'npm',
    label: 'npm',
    lang: 'ts',
    code: `// npm install chartist
import { lineChart } from 'chartist';
import 'chartist/styles.css';

lineChart('#chart', { series: [[1, 3, 2, 5]] });`
  },
  {
    id: 'cdn',
    label: '<script type="module">',
    lang: 'html',
    code: `<link rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/chartist@2/dist/index.min.css">
<script type="module">
  import { lineChart } from
    'https://cdn.jsdelivr.net/npm/chartist@2/dist/index.min.js';
  lineChart('#chart', { series: [[1, 3, 2, 5]] });
</script>`
  }
] as const;
---

<div
  class="overflow-hidden rounded-lg border-2 border-ink bg-code-bg text-code-ink shadow-print dark:border-black [&_pre]:rounded-none [&_pre]:px-5 [&_pre]:py-3.5 [&_pre]:text-[13px] [&_pre]:leading-[1.6]"
  data-tabs
>
  <div class="flex items-center justify-between gap-2 border-b border-code-line py-1.5 pr-2 pl-4">
    <div role="tablist" aria-label="Install method">
      {
        TABS.map((tab, i) => (
          <button
            class="min-h-9 cursor-pointer rounded-[8px] border-0 bg-transparent px-3 py-2.5 font-mono text-xs leading-none font-semibold text-code-muted aria-selected:bg-code-hover aria-selected:text-code-ink aria-selected:shadow-[inset_0_-2px_0_var(--code-accent)]"
            type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {tab.label}
          </button>
        ))
      }
    </div>
  </div>
  {
    TABS.map((tab, i) => (
      <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0} tabindex="0">
        <Code code={rewriteInstallText(tab.code)} lang={tab.lang} theme="css-variables" />
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        other.tabIndex = selected ? 0 : -1;
        root.querySelector(`#${other.getAttribute('aria-controls')}`)?.toggleAttribute('hidden', !selected);
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', event => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (step) {
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        }
      });
    });
  }
</script>

