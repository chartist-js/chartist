---
import { Code } from 'astro:components';
import Chart from '../Chart.astro';
import { SWATCHES } from '../../data/landing';
import { facts, formatKb } from '../../data/facts';

const sizes = facts.sizes.bytes;
const RESPONSIVE = `responsive([
  ['(width < 600px)', small],
  [container('(width < 400px)'), tiny]
])`;
const SSR = `renderToString(toScene(config, size))`;
---

<section id="features" class="section sunken" data-section>
  <div class="wrap">
    <div class="section-head reveal">
      <h2>What makes it worth it</h2>
      <p>The things people pick Chartist for, each with a tiny live demo.</p>
    </div>
    <div class="grid-auto">
      <article class="card feature reveal">
        <h3>Style it with CSS</h3>
        <p class="muted">Plain SVG with predictable classes. Pick a color:</p>
        <div class="demo swatch-demo" data-swatch-demo>
          <Chart
            type="line"
            label="A smooth line chart in the chosen color"
            aspect="16 / 7"
            data={{ labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'], series: [[1, 5, 2, 5, 4, 3, 6]] }}
            options={{ low: 0, showArea: true, fullWidth: true, axisY: { offset: 24 } }}
          />
          <div class="swatches" role="group" aria-label="Pick --ct-series-a">
            {
              SWATCHES.map((swatch, i) => (
                <button class="swatch-btn" type="button" aria-label={`Set --ct-series-a to ${swatch.name}`} aria-pressed={i === 0 ? 'true' : 'false'} data-color={swatch.hex} style={{ background: swatch.hex }} />
              ))
            }
            <code>--ct-series-a</code>
          </div>
        </div>
      </article>
      <article class="card feature reveal">
        <h3>Responsive, two ways</h3>
        <p class="muted">By the window, or by the chart's own container (experimental), with the conditions you write in CSS.</p>
        <div class="demo stack">
          <Code code={RESPONSIVE} lang="ts" theme="css-variables" />
        </div>
      </article>
      <article class="card feature reveal">
        <h3>Composed charts</h3>
        <p class="muted">Bars and lines in one chart, each on its own Y axis.</p>
        <div class="demo">
          <Chart type="composed" label="Bars on a left axis and a line on a right axis" aspect="16 / 8" data={{ labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], series: [[4, 6, 5, 8, 7, 9], [20, 45, 38, 60, 72, 90]] }} />
        </div>
      </article>
      <article class="card feature reveal">
        <h3>Renders anywhere SVG does</h3>
        <p class="muted">Real SVG text labels. Render on the server for PDFs, email and images.</p>
        <div class="demo stack">
          <Code code={SSR} lang="ts" theme="css-variables" />
        </div>
      </article>
      <article class="card feature reveal">
        <h3>Tiny, and no build step</h3>
        <p class="muted">You ship only what you import. A CDN module or npm, your pick.</p>
        <div class="demo">
          <ul class="sizes">
            <li><span>✓ core (<code>chart</code>)</span><span>{formatKb(sizes['chartist (core: chart)'].gzip)}</span></li>
            <li><span>✓ core + <code>lineChart</code></span><span>{formatKb(sizes['chartist (lineChart)'].gzip)}</span></li>
            <li class="muted"><span>✗ <code>barChart</code></span><span>not imported</span></li>
            <li class="muted"><span>✗ <code>pieChart</code></span><span>not imported</span></li>
          </ul>
        </div>
      </article>
      <article class="card feature reveal">
        <h3>Colors for everyone</h3>
        <p class="muted">An opt-in color-blind-safe palette for light and dark mode.</p>
        <div class="demo ct-theme-accessible stack">
          <div class="palette" aria-hidden="true">
            {['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'].map(letter => <span class={`ct-series-${letter}`} />)}
          </div>
          <code>class="ct-theme-accessible"</code>
        </div>
      </article>
    </div>
    <div class="also reveal">
      <span>And also:</span>
      <span class="tag">Typed functional API</span>
      <span class="tag">Zero dependencies</span>
      <span class="tag">1.x code keeps working</span>
    </div>
  </div>
</section>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>('[data-swatch-demo]')) {
    const buttons = [...demo.querySelectorAll<HTMLButtonElement>('[data-color]')];
    for (const button of buttons) {
      button.addEventListener('click', () => {
        demo.style.setProperty('--ct-series-a', button.dataset.color!);
        buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      });
    }
  }
</script>

<style>
  .demo.stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: stretch;
    place-items: stretch;
  }
  .demo :global(pre.astro-code) {
    font-size: 12.5px;
    padding: 12px 14px;
  }
  .swatch-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    place-items: stretch;
  }
  .swatches,
  .tags,
  .also {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .also {
    margin-top: 28px;
  }
  .sizes {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--fs-sm);
  }
  .sizes li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .palette {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
  }
  .palette span {
    height: 36px;
    border-radius: var(--r-sm);
    background: var(--ct-color);
  }
</style>
