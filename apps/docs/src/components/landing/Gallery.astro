---
import Chart from '../Chart.astro';
import { GALLERY } from '../../data/landing';
---

<section class="wrap section" id="gallery" data-visual="gallery">
  <div class="section-head reveal">
    <h2>A few of our favourite charts</h2>
    <p>Every one is a plain SVG element that draws itself as it scrolls into view.</p>
  </div>
  <div class="grid-auto">
    {
      GALLERY.map(item => (
        <article class="card reveal flex flex-col gap-3 px-4.5 pt-4.5 pb-4">
          <div class="rounded-md bg-bg px-2.5 pt-3 pb-1.5">
            <Chart type={item.type} label={`${item.title} chart`} aspect="16 / 10" data={item.data} options={item.options} />
          </div>
          <div class="flex items-baseline justify-between gap-2">
            <strong class="font-slab text-[20px] leading-[1.2] font-bold">{item.title}</strong>
            <code>{item.api}</code>
          </div>
          <span class="muted">{item.note}</span>
        </article>
      ))
    }
  </div>
</section>

