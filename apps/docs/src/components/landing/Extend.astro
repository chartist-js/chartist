---
import { Code } from 'astro:components';
import { PIPELINE } from '../../data/landing';
import pluginSource from '../../demos/plugins.ts?raw';

// Only the lollipop plugin: the short helper it calls is self-explanatory.
const lollipopSource = pluginSource
  .slice(pluginSource.indexOf('/** Lollipop'), pluginSource.indexOf('/** The value above'))
  .trim();
const LOLLIPOP_CSS = `/* style.css */
.ct-lollipops .ct-bar { stroke-width: 3px; }`;
---

<section id="extend" class="wrap section" data-section data-visual="extend">
  <div class="section-head reveal">
    <h2>Bend it to your will</h2>
    <p>Every chart flows through an open pipeline. Each phase has an event, and every single element passes through <code>compose</code>, where you can change, replace or decorate it. Plugins use the same events.</p>
  </div>
  <!-- One row of seven on wide screens, else one column: arrows always follow the flow. -->
  <ol class="steps reveal m-0 grid list-none gap-7 p-0 lg:grid-cols-7 lg:gap-8" aria-label="The rendering pipeline">
    {
      PIPELINE.map((step, i) => (
        <li class="relative flex items-center gap-3 rounded-md border-2 border-ink bg-surface px-3.5 py-2.5 shadow-print-sm lg:flex-col lg:items-start lg:justify-between lg:gap-2.5 lg:pt-3.5 lg:pb-3 dark:border-line-strong">
          <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <strong class="font-slab text-xl leading-[1.15] font-bold">{step.title}</strong>
          <code class="ml-auto w-fit text-[12.5px] lg:ml-0">on('{step.phase}')</code>
        </li>
      ))
    }
  </ol>
  <div class="mt-8 mb-5 grid grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] items-start gap-6">
    <div class="card reveal flex flex-col gap-4 p-5">
      <div class="flex flex-wrap justify-between gap-3">
        <strong>Same data, three tiny plugins</strong>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Toggle plugins">
          <button class="chip" type="button" aria-pressed="true" data-plugin="lollipop">lollipop()</button>
          <button class="chip" type="button" aria-pressed="true" data-plugin="valueLabels">valueLabels()</button>
          <button class="chip" type="button" aria-pressed="false" data-plugin="threshold">threshold(7)</button>
        </div>
      </div>
      <div class="plugin-chart aspect-[16/9] min-h-0" data-plugin-chart role="img" aria-label="A bar chart changed by the selected plugins"></div>
      <pre class="m-0 font-mono text-[13px] leading-[1.5] whitespace-pre-wrap text-ink-2" data-plugin-usage></pre>
    </div>
    <div class="snippet reveal flex min-w-0 flex-col gap-3">
      <Code code={lollipopSource} lang="ts" theme="css-variables" />
      <Code code={LOLLIPOP_CSS} lang="css" theme="css-variables" />
    </div>
  </div>
  <p class="muted reveal">Community plugins add tooltips, legends and zoom; plugins written for 1.x run in v2 through <code>fromLegacyPlugin</code>.</p>
</section>

<script>
  import { mountPluginDemo } from '../../scripts/landing/plugins';
  mountPluginDemo();
</script>

<style>
  /* The arrows between the phases, centered in the gap: down in the
     column, right in the row (lg, 1100px). */
  .steps > li:not(:last-child)::after {
    content: '↓';
    position: absolute;
    left: 50%;
    bottom: -26px;
    z-index: 1;
    transform: translateX(-50%);
    font: 700 20px / 1 var(--font-body);
    color: var(--brand);
  }
  @media (min-width: 68.75rem) {
    .steps > li:not(:last-child)::after {
      content: '→';
      top: 50%;
      right: -26px;
      bottom: auto;
      left: auto;
      transform: translateY(-50%);
      font-size: 22px;
    }
  }
  /* Shiki output stays CSS: code wraps instead of scrolling sideways. */
  .snippet :global(pre.astro-code) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Chartist's SVG and the lollipop plugin's elements. */
  .plugin-chart :global(svg) {
    display: block;
  }
  .plugin-chart :global(.ct-lollipops .ct-bar) {
    stroke-width: 3px;
  }
  .plugin-chart :global(.ct-lollipop) {
    fill: var(--ct-color);
  }
  .plugin-chart :global(.ct-value-label) {
    fill: var(--ink);
    font: 700 12px var(--font-body);
  }
</style>
