---
import { RELEASE } from '../../data/release';
---

<aside class="wrap mb-10" aria-label="Latest release" data-visual="release">
  <a href={RELEASE.href} class="card flat flex flex-wrap items-center gap-x-3.5 gap-y-2 bg-surface px-5 py-3.5 text-ink no-underline">
    <span class="tag brand">{RELEASE.tag}</span>
    <strong>{RELEASE.title}</strong>
    <span class="muted">{RELEASE.text}</span>
    <span class="pill-link ml-auto">{RELEASE.linkLabel} →</span>
  </a>
</aside>
