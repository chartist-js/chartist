---
import { Code } from 'astro:components';
import Mascot from '../Mascot.astro';
import { CHAPTERS } from '../../data/landing';

const SCENES = ['line', 'bars', 'donut', 'composed'] as const;
const LABELS = {
  line: 'A line chart with two series',
  bars: 'A bar chart with two series per quarter',
  donut: 'A donut chart with four slices',
  composed: 'Bars on a left axis and a line on a right axis'
};
---

<section id="story" class="wrap section" data-section data-visual="story">
  <div class="story" data-story>
    <div class="story-sticky">
      <div class="story-stage" data-scene="line" data-active="0">
        <div class="stage-art">
          <div class="stage-hero">
            <Mascot pose="hero">
              <div class="stage-scenes">
                {SCENES.map(scene => <div class="board-chart stage-scene ct-draw" data-stage-scene={scene} role="img" aria-label={LABELS[scene]} />)}
              </div>
            </Mascot>
          </div>
          <div class="stage-celebrate" hidden>
            <Mascot pose="celebrate">
              <div class="board-chart ct-draw" data-stage-scene="final" role="img" aria-label={LABELS.composed}></div>
            </Mascot>
          </div>
        </div>
        <p class="muted stage-caption" aria-live="polite">
          <span class="eyebrow" data-step>1 / {CHAPTERS.length}</span>
          <span data-caption>{CHAPTERS[0].title}</span>
        </p>
        <div class="dots" role="group" aria-label="Story chapters">
          {
            CHAPTERS.map((chapter, i) => (
              <button type="button" aria-label={chapter.title} aria-current={i === 0 ? 'true' : undefined} data-pick={i}>
                <span />
              </button>
            ))
          }
        </div>
      </div>
    </div>
    <div>
      {
        CHAPTERS.map((chapter, i) => (
          <article class="story-chapter reveal" id={`chapter-${i + 1}`} data-chapter={i} data-scene={chapter.scene} data-reaction={chapter.reaction} data-celebrate={chapter.celebrate ? '' : undefined}>
            <span class="eyebrow">Chapter {i + 1}</span>
            <h3>{chapter.title}</h3>
            <p class="lead">{chapter.text}</p>
            <div data-sample={chapter.celebrate ? undefined : ''}>
              <Code code={chapter.code} lang="ts" theme="css-variables" />
            </div>
            <button class="pill-link" type="button" data-pick={i}>
              Show it on the easel →
            </button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { mountStory } from '../../scripts/landing/story';
  mountStory();
</script>

<style>
  .stage-scenes {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .stage-scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
  }
  .stage-scene[data-active] {
    opacity: 1;
  }
  .stage-caption {
    text-align: center;
    font-size: 14px;
    min-height: 22px;
  }
  .stage-caption .eyebrow {
    margin-right: 8px;
  }
  .story-chapter .pill-link {
    border: 0;
    background: none;
    padding: 10px 0;
    min-height: 44px;
    cursor: pointer;
    width: fit-content;
  }
</style>
