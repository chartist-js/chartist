---
import { Code } from 'astro:components';

const CODE = `barChart('#chart', data, options, [
  [container('(width >= 520px)'), {
    axisX: { labelInterpolationFnc: month }    // "Jan"
  }],
  [container('(360px <= width < 520px)'), {
    axisX: { labelInterpolationFnc: initial }  // "J"
  }],
  [container('(width < 360px)'), {
    axisX: { labelInterpolationFnc: quarter }  // "Q1"
  }]
]);`;
---

<section id="responsive" class="section sunken" data-section data-visual="responsive">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Responsive sugar topping</h2>
      <p>Grab the corner and squeeze the chart. The labels rearrange themselves, driven by the same conditions you'd write in CSS.</p>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] items-start gap-6">
      <div class="flex min-w-0 flex-col gap-3">
        <!-- 552 px with border-box, 14 px padding and a 2 px border: 520 px of content, so the widest rule applies first. -->
        <div
          class="@container relative w-[552px] max-w-full min-w-[260px] resize-x overflow-hidden rounded-lg border-2 border-ink bg-surface px-3.5 pt-3.5 pb-5.5 shadow-print after:pointer-events-none after:absolute after:right-4.5 after:bottom-1 after:font-mono after:text-[11px] after:leading-[normal] after:font-semibold after:text-ink-2 after:content-['drag_↘'] max-md:w-full"
          data-resizable
        >
          <div class="mb-2 flex justify-between"><strong>Resize me</strong><code data-width>520 px</code></div>
          <div class="h-[220px]" data-responsive-chart role="img" aria-label="A bar chart of twelve months whose labels adapt to its width"></div>
        </div>
        <label class="flex flex-col gap-1.5 text-sm text-ink-2">
          Or use the keyboard: container width
          <input class="w-full accent-brand" type="range" min="260" max="640" step="10" value="520" data-width-range />
        </label>
      </div>
      <div class="flex min-w-0 flex-col gap-3">
        <div class="-mb-3 flex items-center justify-between gap-2 rounded-t-lg border-b border-code-line bg-code-bg py-1.5 pr-2 pl-4">
          <span class="min-h-9 rounded-[8px] bg-code-hover px-3 py-2.5 font-mono text-xs leading-none font-semibold text-code-ink shadow-[inset_0_-2px_0_var(--code-accent)]">responsive</span><span class="tag">active: <span data-rule>container(width ≥ 520px)</span></span>
        </div>
        <Code code={CODE} lang="ts" theme="css-variables" class="rounded-t-none rounded-b-lg" />
        <span class="tag">Experimental: container() needs the match-container polyfill today</span>
      </div>
    </div>
    <div class="reveal mt-14 flex flex-col gap-3">
      <h3>One chart, two cards</h3>
      <p class="muted">The same chart in a narrow and a wide card. Container queries pick the right options for each, no matter how wide the window is.</p>
      <div class="mt-2 grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-5 max-md:grid-cols-[minmax(0,1fr)]">
        {
          [1, 2].map(() => (
            <div class="card @container flex flex-col items-start gap-2.5 p-4">
              <span class="tag @min-[400px]:hidden">container (width &lt; 400px)</span>
              <span class="tag ok hidden @min-[400px]:inline-flex">container (width ≥ 400px)</span>
              <div class="h-[200px] w-full" data-cq-chart role="img" aria-label="A line chart that adapts to its card"></div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { mountResponsiveDemo } from '../../scripts/landing/responsive';
  const section = document.getElementById('responsive');
  if (section) {
    const observer = new IntersectionObserver(
      entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer.disconnect();
          void mountResponsiveDemo();
        }
      },
      { rootMargin: '100% 0px' }
    );
    observer.observe(section);
  }
</script>

