---
import Logomark from '../Logomark.astro';
import { LIBRARIES, NAMES, ROWS, SIZE_KEYS } from '../../data/comparison';
import { facts, formatDate, formatKb } from '../../data/facts';

const bytes = facts.sizes.bytes as Record<string, { gzip: number }>;
/** The distinct sources of a library's cells, in row order. */
const sourcesOf = (lib: (typeof LIBRARIES)[number]) => [...new Set(ROWS.map(row => row.cells[lib].source))];
/** What a source is, from its address: License, npm package, README, … */
const sourceLabel = (url: string) => {
  const { hostname, pathname, hash } = new URL(url);
  // The last path segment that isn't a version ("latest", "v4").
  const last =
    pathname
      .split('/')
      .filter(segment => segment && !/^(latest|v?\d[\d.]*)$/.test(segment))
      .pop() ?? '';
  if (/license/i.test(pathname)) {return 'License';}
  if (hostname.includes('npmjs.com')) {return 'npm package';}
  if (hash === '#readme') {return 'README';}
  if (hostname.startsWith('shop.')) {return 'Pricing';}
  if (hostname === 'github.com' && pathname.split('/').filter(Boolean).length <= 2) {return 'Repository';}
  return `Docs: ${last.replace(/\.html$/, '').replace(/[-_]/g, ' ')}`;
};
const smallest = Math.min(...LIBRARIES.map(lib => bytes[SIZE_KEYS[lib]].gzip));
// Table cells. The Chartist column is tinted, its head marked with a brand bar.
const pad = 'px-4 py-3.5 text-left align-top';
const cell = `${pad} border-b border-line`;
const rowHead = 'sticky left-0 bg-surface font-bold';
const us = (lib: string) => lib === 'chartist' && 'bg-[color-mix(in_oklab,var(--accent)_16%,var(--surface))]';
const value = (good?: boolean) => ['block', good && "before:font-bold before:text-ok before:content-['✓_']"];
const rowHint = 'block mt-0.5 text-[12.5px] font-normal text-ink-2';
---

<section id="compare" class="section sunken" data-section data-visual="compare">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>How Chartist compares</h2>
      <p>An honest look next to Chart.js, ApexCharts and Highcharts. They're excellent libraries; pick the one that fits the job.</p>
    </div>
    <div class="flex flex-col gap-5">
      <div class="overflow-x-auto rounded-lg border-2 border-ink bg-surface shadow-print dark:border-line-strong" role="region" aria-label="Library comparison" tabindex="0">
        <table class="w-full min-w-[760px] border-separate border-spacing-0 text-sm">
          <caption class="sr-only">Chartist compared with Chart.js, ApexCharts and Highcharts</caption>
          <thead>
            <tr>
              <th scope="col" class={`${pad} font-mono text-xs leading-[normal] font-semibold tracking-[0.06em] text-ink-2 uppercase`}>Measured on {formatDate(facts.generatedAt)}</th>
              {
                LIBRARIES.map(lib => (
                  <th scope="col" class:list={[pad, 'font-slab text-lg leading-[1.2] font-bold', us(lib), lib === 'chartist' && 'shadow-[inset_0_4px_0_var(--brand)]']}>
                    {lib === 'chartist' ? (
                      <span class="inline-flex items-center gap-2">
                        <Logomark class="w-6" />
                        Chartist
                      </span>
                    ) : (
                      NAMES[lib]
                    )}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class={`${cell} ${rowHead}`}>Bundle size<span class={rowHint}>a line chart, minified and gzipped</span></th>
              {
                LIBRARIES.map(lib => (
                  <td class:list={[cell, us(lib)]}>
                    <span class:list={value(bytes[SIZE_KEYS[lib]].gzip === smallest)}>{formatKb(bytes[SIZE_KEYS[lib]].gzip)}</span>
                    <span class="text-xs text-ink-2">{lib === 'chartist' ? 'this build' : `v${facts.sizes.versions[lib === 'chartjs' ? 'chart.js' : lib]}`}</span>
                  </td>
                ))
              }
            </tr>
            {
              ROWS.map(row => (
                <tr>
                  <th scope="row" class={`${cell} ${rowHead}`}>
                    {row.label}
                    {row.hint && <span class={rowHint}>{row.hint}</span>}
                  </th>
                  {LIBRARIES.map(lib => {
                    const entry = row.cells[lib];
                    return (
                      <td class:list={[cell, us(lib)]}>
                        <span class:list={value(entry.good)}>{entry.value}</span>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
            <tr>
              <th scope="row" class={`${pad} ${rowHead}`}>Sources</th>
              {
                LIBRARIES.map(lib => (
                  <td class:list={[pad, us(lib)]}>
                    <ul class="m-0 flex list-none flex-col gap-1 p-0">
                      {sourcesOf(lib).map(url => (
                        <li>
                          <a href={url} title={url} class="text-[12.5px] text-ink-2 [overflow-wrap:anywhere]">{sourceLabel(url)}</a>
                        </li>
                      ))}
                    </ul>
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
      <div class="grid-auto">
        <div class="card flat flex flex-col gap-1.5 bg-surface px-5 py-4.5"><strong class="font-slab text-lg leading-[normal] font-bold">Where Chartist shines</strong><p>Small bundles, plain SVG, styling with the CSS you already write, ES modules straight from a CDN with no build step, and a permissive license.</p></div>
        <div class="card flat flex flex-col gap-1.5 bg-surface px-5 py-4.5"><strong class="font-slab text-lg leading-[normal] font-bold">Where others offer more</strong><p>More chart types out of the box, and built-in interactivity like tooltips, zoom and panning. If you need a full dashboard toolkit, they're great choices.</p></div>
      </div>
      <details class="text-sm text-ink-2">
        <summary class="min-h-8 cursor-pointer font-bold text-ink">How we measured</summary>
        <p>{facts.sizes.method} Versions: Chart.js {facts.sizes.versions['chart.js']}, ApexCharts {facts.sizes.versions.apexcharts}, Highcharts {facts.sizes.versions.highcharts}. Feature and license rows come from each library's own documentation, listed under Sources. Last run {formatDate(facts.generatedAt)}. Spotted something out of date? <a href="https://github.com/chartist-js/chartist/issues">Open an issue</a>.</p>
      </details>
    </div>
  </div>
</section>

