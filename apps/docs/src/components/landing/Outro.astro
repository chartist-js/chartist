---
import Mascot from '../Mascot.astro';
import { ECOSYSTEM } from '../../data/ecosystem';
import { facts } from '../../data/facts';
import { REPO, href } from '../../lib/site';
---

<section class="wrap section" data-visual="ecosystem">
  <div class="section-head reveal">
    <h2>Fits whatever you build with</h2>
    <p>Framework-free, so it works everywhere. Community wrappers make it feel native in your stack.</p>
  </div>
  <div class="grid-auto-sm">
    {
      ECOSYSTEM.map(entry => (
        <a class="card flat reveal flex flex-col gap-1.5 bg-surface px-5 py-4.5 text-ink no-underline" href={entry.href}>
          <strong>{entry.name}</strong>
          <code class="w-fit">{entry.pkg}</code>
          <span class="muted">{entry.note}</span>
        </a>
      ))
    }
  </div>
</section>

<section class="wrap section grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] gap-6" data-visual="community">
  <div class="card reveal flex flex-col gap-3.5 p-7">
    <h2 class="text-2xl">Made by a community since 2014</h2>
    <p class="muted">{facts.github.contributors} contributors have shaped Chartist since 2014. Questions, ideas and pull requests are all welcome.</p>
    <div class="flex flex-wrap gap-2.5">
      <a class="btn sm" href={REPO}>Star on GitHub</a>
      <a class="btn sm" href={`${REPO}/discussions`}>Join the discussion</a>
      <a class="btn sm" href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contribute</a>
    </div>
  </div>
  <div class="reveal grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] items-center gap-6 rounded-xl border-2 border-dashed border-line-strong px-8 py-7">
    <div>
      <span class="eyebrow">Supported by</span>
      <strong class="block font-slab text-2xl leading-[normal] font-bold">Cube</strong>
    </div>
    <p>Cube helped move Chartist to TypeScript and keeps supporting its development. Thank you! <a href="https://cube.dev">Visit cube.dev</a></p>
  </div>
</section>

<section id="start" class="wrap section" data-section data-visual="finale">
  <div class="card dot-grid reveal grid grid-cols-[repeat(auto-fit,minmax(min(380px,100%),1fr))] items-center gap-x-12 gap-y-6 p-[clamp(24px,4vw,48px)]">
    <div class="flex flex-col gap-4.5">
      <h2 class="text-4xl">Ready when you are.</h2>
      <p class="lead">One import, one function call, one chart. He's already celebrating.</p>
      <pre class="m-0 rounded-lg bg-code-bg px-5 py-3.5 font-mono text-sm leading-[normal] text-code-ink"><code>npm install chartist</code></pre>
      <div class="flex flex-wrap gap-2.5">
        <a class="btn primary" href={href('docs/getting-started/')}>Get started</a>
        <a class="btn" href={REPO}>GitHub</a>
      </div>
    </div>
    <Mascot pose="celebrate" />
  </div>
</section>

