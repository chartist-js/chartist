---
/** Inline comment parts: text with its URLs as links, `code`, and {@link} links. */
import type { JSONOutput as J } from 'typedoc';
import { partHref } from '../../lib/api';

interface Props {
  parts: J.CommentDisplayPart[];
}

const { parts } = Astro.props;
const code = (text: string) => text.replace(/^`+|`+$/g, '');
// Bare URLs, such as a guide in @see; a trailing period ends the sentence.
const URL = /(https?:\/\/[^\s<>()]+[^\s<>().,;:])/;
---

{
  parts.map(part => {
    if (part.kind === 'code') {
      return <code>{code(part.text)}</code>;
    }
    if (part.kind === 'inline-tag') {
      const target = partHref(part);
      const label = part.text.trim() || (typeof part.target === 'string' ? part.target : part.text);
      return target ? (
        <a href={target}>
          <code>{label}</code>
        </a>
      ) : (
        <code>{label}</code>
      );
    }
    return part.text.split(URL).map((piece, i) => (i % 2 === 1 ? <a href={piece}>{piece}</a> : piece));
  })
}
