---
/** The Chartist logomark (design Logomark artboard): the Guy's head on a tile. */
interface Props {
  variant?: 'mustard' | 'paper' | 'transparent';
  class?: string;
  /** Accessible name; omit when the mark sits next to the word "Chartist". */
  label?: string;
}

const { variant = 'mustard', class: className, label } = Astro.props;
const background = { mustard: '#F4C63D', paper: '#FBF6EE', transparent: 'transparent' }[variant];
const skin = '#E2A47C';
const ink = '#2B2426';
---

<svg
  class:list={['logomark', className]}
  viewBox="300 62 128 128"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={{ display: 'block', height: 'auto', background, borderRadius: '22%' }}
>
  <circle cx="409" cy="150" r="10" fill={skin}></circle>
  <path
    d="M343,118 L403,118 Q408,118 408,124 L408,198 Q408,222 386,222 L348,222 Q324,222 322,212 Q322,203 333,197 L337,176 L348,160 L321,158 Q312,157 316,149 L335,121 Q337,118 343,118 Z"
    fill={skin}></path>
  <ellipse cx="358" cy="136" rx="4.6" ry="6.2" fill={ink}></ellipse>
  <ellipse cx="384" cy="136" rx="4.6" ry="6.2" fill={ink}></ellipse>
  <path
    d="M362,166 C354,155 340,155 332,165 C326,173 314,175 308,165 C306,183 334,189 362,177 C390,189 418,183 416,165 C410,175 398,173 392,165 C384,155 370,155 362,166 Z"
    fill={ink}></path>
  <ellipse cx="372" cy="120" rx="54" ry="7" fill={ink}></ellipse>
  <path d="M340,120 L337,74 Q372,68 407,74 L404,120 Q372,126 340,120 Z" fill={ink}></path>
  <ellipse cx="372" cy="73" rx="35" ry="5" fill="#453B3E"></ellipse>
  <path d="M338.9,104 Q372,110 405.1,104 L404.3,116 Q372,122 339.7,116 Z" fill="#C8102E"></path>
</svg>
