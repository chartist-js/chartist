---
import { uniqueId } from '../lib/ids';

/**
 * The Chartist Guy (docs/visual-design Mascot artboard), flat variant with
 * its texture: shading, a rosy cheek, the chin spiral, eye shine and ink
 * lines. The logo stays flat.
 * Poses: hero (presenting the board), point, lost (404), celebrate. In the
 * hero and celebrate poses the board holds a live chart: pass it as the
 * default slot; it's placed over the board's chart area.
 *
 * Reactions switch without re-rendering: set data-reaction="curious" or
 * "proud" on the mascot or an ancestor (see mascot.css).
 */
interface Props {
  pose?: 'hero' | 'point' | 'lost' | 'celebrate';
  reaction?: 'none' | 'curious' | 'proud';
  class?: string;
}

const { pose = 'hero', reaction = 'none', class: className } = Astro.props;
// The landing page shows several mascots; each needs its own clip path.
const vestClip = uniqueId('m-clip-vest');

interface Arm {
  d: string;
  hand: string;
  shade: string;
  cls?: string;
}

const arm = (d: string, hx: number, hy: number, angle: number, flip: number, cls?: string): Arm => ({
  d,
  cls,
  hand: `translate(${hx} ${hy}) rotate(${angle}) scale(1.05 ${1.05 * flip})`,
  // Light comes from the left: the shade goes on whichever edge of the
  // mitten ends up facing right.
  shade:
    -flip * Math.sin((angle * Math.PI) / 180) > 0
      ? 'M-2,7 C6,9 17,8 17,0 C16,5 8,6.5 -2,4.2 Z'
      : 'M-2,-7 C6,-9 17,-8 17,0 C16,-5 8,-6.5 -2,-4.2 Z'
});

const ARMS = {
  pointL: arm('M336,238 Q306,232 286,208', 286, 208, -130, -1, 'm-tap'),
  forkR: arm('M408,238 Q444,250 444,280', 444, 282, 92, 1),
  downL: arm('M336,238 Q322,270 326,300', 326, 302, 95, -1),
  upR: arm('M408,238 Q436,226 452,198', 452, 198, -60, 1),
  scratchR: arm('M408,238 Q446,214 428,156', 428, 156, -105, 1),
  cheerL: arm('M336,238 Q322,214 316,188', 316, 188, -100, -1),
  cheerR: arm('M408,238 Q424,214 428,188', 428, 188, -80, 1)
};

const MOUTH = {
  smile:
    'M343,187.5 Q357,192 371,186.5 Q374,186 373,189 Q366,204 357,204 Q348,204 342,190 Q341,187.5 343,187.5 Z',
  o: 'M348.5,194 a5.5,6.5 0 1,0 11,0 a5.5,6.5 0 1,0 -11,0 Z',
  wide: 'M340,185.5 Q357,191 374,184.5 Q377,184 376,187 Q369,212 357,212 Q345,212 339,188 Q338,185.5 340,185.5 Z'
};

const POSES = {
  hero: {
    viewBox: '0 0 480 420',
    easel: true,
    easelTransform: undefined,
    arms: [ARMS.pointL, ARMS.forkR],
    fork: true,
    hatTransform: undefined,
    mouth: MOUTH.smile,
    eyesDx: 0,
    label: 'The Chartist Guy presenting a line chart, hay fork in hand'
  },
  point: {
    viewBox: '276 36 204 372',
    easel: false,
    easelTransform: undefined,
    arms: [ARMS.downL, ARMS.upR],
    fork: false,
    hatTransform: undefined,
    mouth: MOUTH.smile,
    eyesDx: 3,
    label: 'The Chartist Guy pointing the way'
  },
  lost: {
    viewBox: '0 0 480 420',
    easel: true,
    easelTransform: 'translate(60 0) rotate(-12 46 394)',
    arms: [ARMS.downL, ARMS.scratchR],
    fork: false,
    hatTransform: 'translate(4 -4) rotate(14 372 124)',
    mouth: MOUTH.o,
    eyesDx: -3,
    label: 'The Chartist Guy scratching his head next to a toppled chart'
  },
  celebrate: {
    viewBox: '0 0 480 420',
    easel: true,
    easelTransform: undefined,
    arms: [ARMS.cheerL, ARMS.cheerR],
    fork: false,
    hatTransform: 'translate(-14 -44) rotate(-16 372 90)',
    mouth: MOUTH.wide,
    eyesDx: 0,
    label: 'The Chartist Guy celebrating, hat in the air'
  }
} as const;

const p = POSES[pose];
const [vx, vy, vw, vh] = p.viewBox.split(' ').map(Number);
// The board's chart area in the 480 x 420 drawing: the board's inside
// (x 27-261, y 95-261) less a 7-unit inset: x 34, y 102, w 220, h 152.
const board = {
  left: `${((34 - vx) / vw) * 100}%`,
  top: `${((102 - vy) / vh) * 100}%`,
  width: `${(220 / vw) * 100}%`,
  height: `${(152 / vh) * 100}%`
};
const hasBoardChart = (pose === 'hero' || pose === 'celebrate') && Astro.slots.has('default');
const mouthName = pose === 'lost' ? 'o' : pose === 'celebrate' ? 'wide' : 'smile';
---

<div class:list={['mascot-stage', className]} data-reaction={reaction === 'none' ? undefined : reaction}>
  <svg class="mascot" viewBox={p.viewBox} role="img" aria-label={p.label}>
    <defs>
      <clipPath id={vestClip}>
        <path d="M344,222 L358,222 L370,246 L370,318 L334,309 Q325,307 326,299 L333,232 Q334,222 344,222 Z" />
        <path d="M386,222 L400,222 Q410,222 411,232 L418,299 Q419,307 410,309 L374,318 L374,246 Z" />
      </clipPath>
    </defs>
    {
      p.easel && (
        <g class="m-easel" transform={p.easelTransform}>
          <path d="M30,398 a120,6 0 1,0 240,0 a120,6 0 1,0 -240,0" fill="var(--m-ink)" opacity=".1" />
          <g stroke="var(--m-wood)" stroke-width="9" stroke-linecap="round">
            <path d="M70,262 L46,394 M218,262 L242,394 M144,262 L144,386" />
          </g>
          <rect x="134" y="80" width="20" height="16" rx="4" fill="var(--m-wood)" />
          <rect x="24" y="92" width="240" height="172" rx="12" fill="var(--m-board)" stroke="var(--m-ink)" stroke-width="6" />
          {pose === 'lost' && (
            <g stroke="var(--ct-series-a)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none">
              <path d="M60,220 L100,196 L128,206" />
              <path d="M150,170 L190,180 L232,128" stroke-dasharray="6 8" />
            </g>
          )}
        </g>
      )
    }
    {
      pose === 'lost' && (
        <g>
          <rect x="150" y="372" width="12" height="24" rx="3" transform="rotate(20 156 384)" fill="var(--ct-series-a)" />
          <rect x="186" y="382" width="24" height="12" rx="3" fill="var(--ct-series-b)" />
          <circle cx="226" cy="390" r="5" fill="var(--ct-series-a)" />
          <path d="M244,392 L312,380" stroke="var(--m-wood)" stroke-width="5" stroke-linecap="round" />
        </g>
      )
    }
    <g>
      {
        p.arms.map(a => (
          <g class={a.cls}>
            <path d={a.d} stroke="var(--m-ink)" stroke-width="15" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <g transform={a.hand}>
              <path d="M-2,-7 C6,-9 16,-8 17,0 C17,8 6,9 -2,7 Z" fill="var(--m-skin)" />
              <path d={a.shade} fill="var(--m-skin-2)" />
              <path d="M-1,-5.5 C-1,-11 3,-13.5 5.5,-11 C7,-9.5 5,-7 2,-5 Z" fill="var(--m-skin)" />
            </g>
          </g>
        ))
      }
    </g>
    <g class="m-body">
      <ellipse cx="380" cy="398" rx="56" ry="5" fill="var(--m-ink)" opacity="0.12" />
      <path d="M347,320 L342,392" stroke="var(--m-ink)" stroke-width="9" stroke-linecap="round" fill="none" />
      <path d="M397,320 L402,392" stroke="var(--m-ink)" stroke-width="9" stroke-linecap="round" fill="none" />
      <path d="M346.5,388 L346.5,397 L318.5,397 Q324.5,390 337.5,389 Z" fill="var(--m-ink)" />
      <path d="M397.5,388 L397.5,397 L425.5,397 Q419.5,390 406.5,389 Z" fill="var(--m-ink)" />
      <path d="M336,290 L408,290 L407,318 Q406,324 400,324 L344,324 Q338,324 337,318 Z" fill="var(--m-ink)" />
      <path d="M336,312 L408,312 L407,318 Q406,324 400,324 L344,324 Q338,324 337,318 Z" fill="#000" opacity=".25" />
      <path d="M356,222 L388,222 L380,318 L364,318 Z" fill="var(--m-ink)" />
      <path d="M344,222 L358,222 L370,246 L370,318 L334,309 Q325,307 326,299 L333,232 Q334,222 344,222 Z" fill="var(--m-vest)" />
      <path d="M386,222 L400,222 Q410,222 411,232 L418,299 Q419,307 410,309 L374,318 L374,246 Z" fill="var(--m-vest)" />
      <g clip-path={`url(#${vestClip})`}>
        <path d="M404,222 Q414,226 412,240 L420,320 L405,320 Q411,280 404,222 Z" fill="var(--p-waistcoat-600)" />
        <path d="M418,305 Q394,318 372,318 L372,330 L424,330 Z" fill="var(--p-waistcoat-600)" />
        <ellipse cx="372" cy="226" rx="30" ry="8" fill="var(--m-ink)" opacity=".35" />
      </g>
      <path d="M338,272 L356,270" stroke="var(--p-waistcoat-600)" stroke-width="2.6" stroke-linecap="round" fill="none" />
      <circle cx="382" cy="262" r="3.3" fill="var(--m-ink)" />
      <circle cx="382" cy="280" r="3.3" fill="var(--m-ink)" />
      <circle cx="382" cy="298" r="3.3" fill="var(--m-ink)" />
    </g>
    {
      p.fork && (
        <g transform="rotate(4 444 282)" stroke-linecap="round" fill="none">
          <path d="M444,396 L444,132" stroke="var(--m-wood)" stroke-width="6" />
          <path d="M426,84 L426,132 L462,132 L462,84 M438,86 L438,132 M450,86 L450,132" stroke="var(--m-ink)" stroke-width="4" stroke-linejoin="round" />
        </g>
      )
    }
    <g transform="translate(0 6)">
      <g class="m-head">
        <circle cx="409" cy="150" r="10" fill="var(--m-skin)" />
        <path d="M409,146 q4,4 0,8" stroke="var(--m-skin-2)" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <path d="M335,121 C342,96 402,96 408,124 L408,196 C408,224 388,232 366,232 C344,232 322,224 322,210 Q322,203 333,197 L337,176 L348,160 L321,158 Q312,157 316,149 Z" fill="var(--m-skin)" />
        <path d="M408,158 L408,196 C408,224 388,232 366,232 C358,232 350,231 344,229 C368,229 398,224 402,196 C404,180 405,168 408,158 Z" fill="var(--m-skin-2)" opacity=".55" />
        <ellipse cx="396" cy="162" rx="10" ry="6.5" fill="#E8735F" opacity=".55" />
        <path d="M346,222.5 c1.5,-2.6 -1.4,-4.6 -3.6,-3 c-2.8,2 -1.2,6.4 2.4,6.6 c4.6,.2 6.6,-5.4 3.8,-8.8" stroke="var(--m-skin-2)" stroke-width="2.3" fill="none" stroke-linecap="round" />
        <g transform={`translate(${p.eyesDx} 0)`}>
          <g class="m-eyes">
            <ellipse cx="358" cy="136" rx="4.4" ry="6" fill="var(--m-ink)" />
            <ellipse cx="384" cy="136" rx="4.4" ry="6" fill="var(--m-ink)" />
            <circle cx="356.4" cy="133.2" r="1.4" fill="#fff" />
            <circle cx="382.4" cy="133.2" r="1.4" fill="#fff" />
          </g>
        </g>
        {
          (['smile', 'wide', 'o'] as const).map(name => (
            <path class:list={[`m-mouth m-mouth-${name}`, { 'm-mouth-default': name === mouthName }]} d={MOUTH[name]} fill="#6E1F2A" />
          ))
        }
        <path class="m-brow" d="M377,126 Q384,119 391,125" stroke="var(--m-ink)" stroke-width="3.2" fill="none" stroke-linecap="round" />
        <g class="m-stache">
          <path d="M362,166 C354,155 340,155 332,165 C326,173 314,175 308,165 C306,183 334,189 362,177 C390,189 418,183 416,165 C410,175 398,173 392,165 C384,155 370,155 362,166 Z" fill="var(--m-ink)" />
          <path d="M356,163 C348,159 340,161 334,168 M368,163 C376,159 386,161 392,168" stroke="#4A3F42" stroke-width="1.6" fill="none" stroke-linecap="round" />
        </g>
      </g>
      <g transform={p.hatTransform}>
        <g class:list={['m-hat', { 'm-hat-fly': pose === 'celebrate' }]}>
          <g class="m-hat-tip">
            <ellipse cx="372" cy="120" rx="54" ry="7" fill="var(--m-ink)" />
            <path d="M340,120 L337,74 Q372,68 407,74 L404,120 Q372,126 340,120 Z" fill="var(--m-ink)" />
            <ellipse cx="372" cy="73" rx="35" ry="5" fill="#453B3E" />
            <path d="M338.9,104 Q372,110 405.1,104 L404.3,116 Q372,122 339.7,116 Z" fill="var(--m-vest)" />
            <path d="M346,79 L348,101" stroke="#5E5154" stroke-width="4" stroke-linecap="round" />
          </g>
        </g>
      </g>
    </g>
    {
      pose === 'celebrate' && !hasBoardChart && (
        <g aria-hidden="true">
          <text x="144" y="208" text-anchor="middle" font-size="84" font-weight="800" letter-spacing="-4" fill="var(--ct-series-a)">
            v2
          </text>
          <path d="M84,226 C112,236 176,236 204,226" stroke="var(--accent)" stroke-width="6" fill="none" stroke-linecap="round" />
        </g>
      )
    }
    {
      pose === 'celebrate' && (
        <g class="m-confetti" aria-hidden="true">
          <rect x="300" y="40" width="8" height="14" rx="2" fill="var(--ct-series-a)" />
          <rect x="440" y="70" width="8" height="14" rx="2" fill="var(--ct-series-b)" />
          <circle cx="290" cy="110" r="5" fill="var(--ct-series-c)" />
          <rect x="452" y="140" width="8" height="14" rx="2" fill="var(--ct-series-c)" />
          <circle cx="420" cy="26" r="5" fill="var(--ct-series-e)" />
          <rect x="270" y="170" width="8" height="14" rx="2" fill="var(--ct-series-d)" />
          <circle cx="252" cy="60" r="4" fill="var(--ct-series-f)" />
          <rect x="466" y="20" width="8" height="14" rx="2" fill="var(--ct-series-g)" />
        </g>
      )
    }
    {
      pose === 'lost' && (
        <text class="m-q" x="296" y="96" font-size="58" font-weight="800" fill="var(--ct-series-a)" aria-hidden="true">
          ?
        </text>
      )
    }
  </svg>
  {
    hasBoardChart && (
      <div class="mascot-board" style={board}>
        <slot />
      </div>
    )
  }
</div>
